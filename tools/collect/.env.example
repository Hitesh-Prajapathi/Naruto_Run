# Optional. If unset the Upload button is hidden and only "Download session" is offered.
# Must be https:// when the app itself is served over https (mixed-content rule).
VITE_UPLOAD_URL=https://collect.example.org
# Optional convenience. Anything VITE_* is public in the built JS, so prefer leaving
# this blank and having each subject type the token you send them.
VITE_UPLOAD_TOKEN=
